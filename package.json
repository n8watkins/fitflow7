{
  "name": "fitflow7",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:android": "tsc -b && vite build --mode native",
    "lint": "eslint .",
    "test": "vitest run",
    "preview": "vite preview",
    "release": "release-kit release",
    "release:check": "release-kit check && npm run lint && npm test && npm run build",
    "prepare": "git config core.hooksPath .githooks || true",
    "preview:worker": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types worker-configuration.d.ts"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.0",
    "@capgo/capacitor-health": "^8.11.14",
    "@libsql/client": "^0.17.3",
    "@tailwindcss/vite": "^4.3.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.18.5",
    "tailwindcss": "^4.3.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "release-kit": "github:n8watkins/release-kit#v2.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "wrangler": "^4.157.0"
  }
}
