{
  "name": "fitflow7",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:android": "tsc -b && vite build --mode native",
    "lint": "eslint .",
    "test": "vitest run",
    "preview": "vite preview",
    "release": "release-kit release",
    "release:check": "release-kit check && npm run lint && npm test && npm run build",
    "prepare": "git config core.hooksPath .githooks || true",
    "preview:worker": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types worker-configuration.d.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.0",
    "@capgo/capacitor-health": "^8.12.0",
    "@libsql/client": "^0.18.0",
    "@sentry/browser": "^11.11.0",
    "@sentry/cloudflare": "^11.11.0",
    "@tailwindcss/vite": "^4.3.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tailwindcss": "^4.3.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.14.0",
    "release-kit": "github:n8watkins/release-kit#v2.10.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
